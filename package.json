{
  "name": "dsh-insights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Insights · DeepSeek Harness 全景观察站：插件健康 · 官方动态 · 生态趋势。零依赖 Node 管线：collect 采集 → validate 校验 → analyze 分析 → publish 发布 → content 内容（信件/周报）。",
  "bin": {
    "dsh-insights": "./bin/dsh-insights.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "run": "node bin/dsh-insights.mjs",
    "pipeline": "node bin/pipeline.mjs",
    "discover": "node pipeline/collect/discover.mjs",
    "validate": "node pipeline/validate/validate.mjs",
    "analyze": "node pipeline/analyze/analyze.mjs",
    "site": "node pipeline/publish/site.mjs",
    "export": "node pipeline/publish/export-csv.mjs",
    "query": "node bin/query.mjs",
    "regress": "node pipeline/validate/regress.mjs",
    "score": "node pipeline/analyze/score.mjs",
    "export:json": "node pipeline/publish/export-json.mjs",
    "compat": "node pipeline/analyze/compat.mjs",
    "badges": "node pipeline/publish/badges.mjs",
    "history": "node pipeline/analyze/history.mjs",
    "overlap": "node pipeline/analyze/overlap.mjs",
    "snapshot": "node bin/pipeline.mjs snapshot",
    "finalize": "npm run analyze && npm run site && npm run export && node bin/query.mjs --sort stars --top 8",
    "lists": "node pipeline/collect/lists.mjs",
    "downloads": "node pipeline/collect/downloads.mjs",
    "diff": "node pipeline/publish/diff.mjs",
    "refresh": "node bin/pipeline.mjs daily",
    "pages": "node pipeline/publish/pages.mjs",
    "suggest": "node bin/export-suggested.mjs",
    "report": "node pipeline/content/letters.mjs",
    "weekly": "node pipeline/content/weekly.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ecosystem",
    "index",
    "analysis"
  ],
  "license": "MIT"
}
